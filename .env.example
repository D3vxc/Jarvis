# Copy to .env and fill in. Never commit the real .env file.

# Required for the LLM answer engine. Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for answers.
CLAUDE_MODEL=claude-opus-5

# Let Claude search the web before answering (better accuracy for current facts).
ENABLE_WEB_SEARCH=true

# Port for the local server.
PORT=3000
